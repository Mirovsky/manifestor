<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.mirovsky.manifestor/UI/ManifestorStyles.uss?fileID=7433441132597879392&amp;guid=4e779a97f5705704797dcfeeb2528496&amp;type=3#ManifestorStyles"/>
    <uie:Toolbar style="justify-content: flex-end;">
        <uie:ToolbarButton text="New Packages List" name="NewPackageListButton" icon-image="project://database/Packages/com.mirovsky.manifestor/Editor/Visuals/d_CreateAddNew.png?fileID=2800000&amp;guid=e694b101fc10eb6458073628553ed7c5&amp;type=3#d_CreateAddNew" style="margin-left: -1px; padding-bottom: 3px; padding-top: 3px; padding-left: 0;"/>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: flex-end;">
            <uie:ToolbarButton text="Apply Changes" name="ApplyButton"/>
            <uie:ToolbarButton text="" name="RefreshButton" icon-image="project://database/Packages/com.mirovsky.manifestor/Editor/Visuals/d_Refresh.png?fileID=2800000&amp;guid=0766aa36fd9591b4b8485ed97a74fd5c&amp;type=3#d_Refresh" style="padding-top: 3px; padding-left: 3px; padding-bottom: 3px; padding-right: 3px;"/>
        </ui:VisualElement>
    </uie:Toolbar>
    <ui:VisualElement name="BulkSelectionHeader" class="manifestor-migration-bulk-selection">
        <ui:Label text="Apply all changes to:" class="manifestor-migration-bulk-selection__label"/>
        <ui:VisualElement name="BulkSelectionToggles" class="manifestor-migration-bulk-selection__toggles"/>
    </ui:VisualElement>
    <ui:VisualElement name="ContentList" style="flex-grow: 1;">
        <ui:ListView name="ContentListView" virtualization-method="DynamicHeight" binding-source-selection-mode="AutoAssign" data-source-path="rows" item-template="project://database/Packages/com.mirovsky.manifestor/UI/PackageItem.uxml?fileID=9197481963319205126&amp;guid=6b9f2b78be20e8f46b9bcb9cf6703013&amp;type=3#PackageItem" allow-add="false" allow-remove="false" selection-type="None" show-alternating-row-backgrounds="All" data-source-type="Manifestor.UI.ManifestorMigrateTool+ViewDataModel, com.mirovsky.manifestor"/>
        <ui:Label text="No migration required." name="EmptyContentList" style="position: absolute; width: 100%; height: 100%; -unity-text-align: middle-center; color: rgb(173, 173, 173);"/>
    </ui:VisualElement>
    <ui:HelpBox name="ChangesHelpBox" text="The current manifest.json differs from your Package Lists. Select which Package Lists should be updated to match the manifest." message-type="Warning" data-source-path="" style="display: flex; margin-top: 2px; margin-bottom: 2px; flex-shrink: 0;"/>
</ui:UXML>
