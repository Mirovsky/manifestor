<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/com.mirovsky.manifestor/UI/ManifestorStyles.uss?fileID=7433441132597879392&amp;guid=4e779a97f5705704797dcfeeb2528496&amp;type=3#ManifestorStyles"/>
    <ui:VisualElement name="Wrapper" data-source-type="Manifestor.UI.ManifestorMigrateTool+MigrationRow, com.mirovsky.manifestor" class="manifestor-migration-row">
        <ui:Label text="Changes" class="manifestor-migration-group-title">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="groupTitle" binding-mode="ToTarget"/>
                <Manifestor.UI.BoolClassBinding property="group-visibility" data-source-path="showsGroupHeader" binding-mode="ToTarget" class-name="manifestor-migration-group-title--visible"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="Header" class="manifestor-migration-row__header">
            <ui:VisualElement class="manifestor-migration-row__identity">
                <ui:Label text="ADD" tooltip="Add this package to the selected Package Lists." class="manifestor-migration-action manifestor-migration-action--add">
                    <Bindings>
                        <Manifestor.UI.BoolClassBinding property="addition-visibility" data-source-path="isAddition" binding-mode="ToTarget" class-name="manifestor-migration-action--visible"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="UPDATE" tooltip="Update this package in the selected Package Lists." class="manifestor-migration-action manifestor-migration-action--update">
                    <Bindings>
                        <Manifestor.UI.BoolClassBinding property="update-visibility" data-source-path="isVersionChange" binding-mode="ToTarget" class-name="manifestor-migration-action--visible"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="REMOVE" tooltip="Remove this package from the selected Package Lists." class="manifestor-migration-action manifestor-migration-action--remove">
                    <Bindings>
                        <Manifestor.UI.BoolClassBinding property="removal-visibility" data-source-path="isRemoval" binding-mode="ToTarget" class-name="manifestor-migration-action--visible"/>
                    </Bindings>
                </ui:Label>
                <ui:Label name="TechnicalName" text="com.package.name" class="manifestor-migration-row__package-name">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="change.packageTechnicalName" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="VersionTransition" class="manifestor-migration-transition">
                <ui:Label text="1.0.0" class="manifestor-migration-transition__value manifestor-migration-transition__value--old">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="previousValue" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="→" class="manifestor-migration-transition__arrow"/>
                <ui:Label text="2.0.0" class="manifestor-migration-transition__value manifestor-migration-transition__value--new">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="nextValue" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PackageLists" class="manifestor-migration-row__targets">
            <ui:Label text="Package Lists" class="manifestor-migration-row__targets-label"/>
            <ui:ListView allow-add="false" allow-remove="false" selection-type="None" virtualization-method="DynamicHeight" item-template="project://database/Packages/com.mirovsky.manifestor/UI/PackageListItem.uxml?fileID=9197481963319205126&amp;guid=ffd2bcfcf5110874c9ec6c5e3943879e&amp;type=3#PackageListItem" show-bound-collection-size="false" binding-source-selection-mode="AutoAssign" fixed-item-height="15" class="manifestor-migration-row__targets-list">
                <Bindings>
                    <ui:DataBinding property="itemsSource" data-source-path="targets" binding-mode="ToTarget"/>
                </Bindings>
            </ui:ListView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
